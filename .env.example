# Cookieflix Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================
PROJECT_NAME=Cookieflix
API_PREFIX=/api
DEBUG=False
ENVIRONMENT=production

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (development)
DATABASE_URL=sqlite:///./cookieflix.db

# PostgreSQL (production recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/cookieflix

# MySQL (alternative)
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/cookieflix

# =============================================================================
# SECURITY - CRITICAL: CHANGE THESE VALUES!
# =============================================================================
# Generate a secure random key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MINIMUM_32_CHARACTERS

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# =============================================================================
# STRIPE PAYMENT INTEGRATION
# =============================================================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# FRONTEND URLS
# =============================================================================
# User-facing frontend
FRONTEND_URL=http://localhost:5173

# Admin panel frontend
ADMIN_FRONTEND_URL=http://localhost:5174

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# Gmail SMTP settings (recommended to use App Password)
EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SENDER=noreply@cookieflix.com
EMAIL_PASSWORD=your_gmail_app_password
ADMIN_EMAIL=admin@cookieflix.com

# Alternative email providers:
# SendGrid: smtp.sendgrid.net (Port 587)
# Mailgun: smtp.mailgun.org (Port 587)
# AWS SES: email-smtp.region.amazonaws.com (Port 587)

# =============================================================================
# FILE UPLOAD
# =============================================================================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880  # 5MB in bytes

# =============================================================================
# PRODUCTION DEPLOYMENT NOTES
# =============================================================================
# 1. Change DEBUG to False
# 2. Set ENVIRONMENT to production
# 3. Generate a secure SECRET_KEY
# 4. Configure a production database (PostgreSQL recommended)
# 5. Set up real Stripe keys
# 6. Configure email service
# 7. Update FRONTEND_URL and ADMIN_FRONTEND_URL to production domains
# 8. Update ALLOWED_ORIGINS to match your production domains
# 9. Set up SSL/TLS certificates
# 10. Configure a reverse proxy (nginx/Apache)
